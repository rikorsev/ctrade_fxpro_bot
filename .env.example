# Copy to .env and fill in. .env is gitignored; never commit real credentials.
CTRADER_CLIENT_ID=your-client-id
CTRADER_CLIENT_SECRET=your-client-secret
# Use a token issued with the "trading" scope; an "accounts" (view-only) token cannot place orders.
CTRADER_ACCESS_TOKEN=your-access-token
# Recommended: the refresh token issued with it. Access tokens expire after 30 days; with this set the bot
# renews them itself and saves the new pair in state/ctrader_token.json (keep that file private).
CTRADER_REFRESH_TOKEN=your-refresh-token
# Optional: cTID trader account ID (default: first demo account for the token)
CTRADER_ACCOUNT_ID=
# Symbol for `python main.py` (quotes) and default symbol list for other commands.
# In testing, noise_breakout made money net of costs only on the Nasdaq 100 CFD; the daily FX strategies
# use a list such as EURUSD,GBPUSD,USDJPY,AUDUSD,NZDUSD,USDCAD,USDCHF.
CTRADER_SYMBOL=#USNDAQ100
CTRADER_SYMBOLS=#USNDAQ100
# Keep 0 for demo. 1 selects a real-money account; `trade` then also needs --allow-live.
CTRADER_LIVE=0
