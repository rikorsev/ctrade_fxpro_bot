# Copy to .env and fill in. .env is gitignored; never commit real credentials.
CTRADER_CLIENT_ID=your-client-id
CTRADER_CLIENT_SECRET=your-client-secret
# Use a token issued with the "trading" scope; an "accounts" (view-only) token cannot place orders.
CTRADER_ACCESS_TOKEN=your-access-token
# Optional: cTID trader account ID (default: first demo account for the token)
CTRADER_ACCOUNT_ID=
# Symbol for `python main.py` (quotes) and default symbol list for other commands
CTRADER_SYMBOL=EURUSD
CTRADER_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,NZDUSD,USDCAD,USDCHF
# Keep 0. Order sending is disabled on live accounts.
CTRADER_LIVE=0
